                      "spec": {
                        "editorMode": "code",
                        "format": 0,
                        "location": "US",
                        "project": "gke-assessment",
                        "rawQuery": true,
                        "rawSql": "SELECT TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(timestamp), 300) * 300) AS time, COUNTIF(httpRequest.status BETWEEN 200 AND 399) AS ok_2xx, COUNTIF(httpRequest.status BETWEEN 400 AND 499) AS blocked_4xx, COUNTIF(httpRequest.status >= 500) AS failed_5xx FROM `gke-assessment.gke_logs.requests` WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
