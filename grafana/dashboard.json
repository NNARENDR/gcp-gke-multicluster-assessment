      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Request latency p50 / p95 / p99 (per 5 min)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-bigquery-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfzkfntifjw1sa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": 0,
                        "location": "US",
                        "project": "gke-assessment",
                        "rawQuery": true,
                        "rawSql": "WITH req AS (SELECT timestamp, SAFE_CAST(REGEXP_REPLACE(CAST(httpRequest.latency AS STRING), r's$', '') AS FLOAT64) * 1000 AS latency_ms FROM `gke-assessment.gke_logs.requests` WHERE $__timeFilter(timestamp) AND httpRequest.status < 400) SELECT TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(timestamp), 300) * 300) AS time, APPROX_QUANTILES(latency_ms, 100)[OFFSET(50)] AS p50_ms, APPROX_QUANTILES(latency_ms, 100)[OFFSET(95)] AS p95_ms, APPROX_QUANTILES(latency_ms, 100)[OFFSET(99)] AS p99_ms FROM req WHERE latency_ms IS NOT NULL GROUP BY time ORDER BY time"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
