      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Pod restarts (per 5 min)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
